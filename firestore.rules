rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Spark plan: atomic public reservations, private admin records, encrypted gallery shares.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'psalmhe@gmail.com' &&
        request.auth.token.email_verified == true;
    }

    function bounded(value, minimum, maximum) {
      return value is string && value.size() >= minimum && value.size() <= maximum;
    }
    function scheduledTime(d) {
      let parts = d.bookingDate.split('-');
      let year = int(parts[0]);
      let day = timestamp.date(year, int(parts[1]), int(parts[2]));
      let march = timestamp.date(year, 3, 1);
      let november = timestamp.date(year, 11, 1);
      // 1970-01-01 was Thursday (4), with Sunday represented as zero.
      let marchSunday = (7 - ((int(march.toMillis() / 86400000) + 4) % 7)) % 7;
      let novemberSunday = (7 - ((int(november.toMillis() / 86400000) + 4) % 7)) % 7;
      let daylight = day >= march + duration.value(7 + marchSunday, 'd') &&
        day < november + duration.value(novemberSunday, 'd');
      return day + duration.value(int(d.bookingTime.split(':')[0]) + (daylight ? 5 : 6), 'h');
    }

    function validNewBooking(slotKey) {
      let d = request.resource.data;
      return d.keys().hasAll(['firstName','lastName','email','phone','occasion','notes','bookingDate','bookingTime',
          'slotKey','timeZone','cancellationToken','startsAt','status','createdAt']) &&
        d.keys().hasOnly(['firstName','lastName','email','phone','occasion','notes','bookingDate','bookingTime',
          'slotKey','timeZone','cancellationToken','startsAt','status','createdAt']) &&
        bounded(d.firstName,1,99) && bounded(d.lastName,1,99) && bounded(d.email,3,254) &&
        d.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') && bounded(d.phone,6,24) &&
        bounded(d.occasion,0,199) && bounded(d.notes,0,999) &&
        d.bookingDate is string && d.bookingDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        d.bookingTime is string && d.bookingTime.matches('^(09|1[0-8]):00$') &&
        d.timeZone == 'America/Chicago' && slotKey == d.bookingDate + ' ' + d.bookingTime && d.slotKey == slotKey &&
        tokenValid(d.cancellationToken) && d.status == 'pending' && d.createdAt == request.time &&
        d.startsAt is timestamp && d.startsAt == scheduledTime(d) &&
        d.startsAt > request.time && d.startsAt < request.time + duration.value(366,'d') &&
        !exists(/databases/$(database)/documents/availability/$(slotKey)) &&
        !exists(/databases/$(database)/documents/bookingReceipts/$(d.cancellationToken)) &&
        getAfter(/databases/$(database)/documents/availability/$(slotKey)).data == {'booked':true,'date':d.bookingDate} &&
        getAfter(/databases/$(database)/documents/bookingCancellations/$(d.cancellationToken)).data.slotKey == slotKey &&
        getAfter(/databases/$(database)/documents/bookingReceipts/$(d.cancellationToken)).data.slotKey == slotKey;
    }
    function galleryPublished(slug) {
      let d = request.resource.data;
      return !('access' in d) || (d.access is map && d.access.keys().hasOnly(['salt','key']) &&
        bounded(d.access.salt,24,24) && bounded(d.access.key,44,44) && d.revision is int && d.revision > 0 &&
        getAfter(/databases/$(database)/documents/galleryShares/$(slug)).data.revision == d.revision &&
        getAfter(/databases/$(database)/documents/galleryShares/$(slug)).data.salt == d.access.salt);
    }
    function tokenValid(token) {
      return token is string && token.matches('^[a-f0-9]{64}$');
    }
    function cancelledTogether(slotKey) {
      let booking = /databases/$(database)/documents/bookings/$(slotKey);
      let token = get(booking).data.cancellationToken;
      let access = /databases/$(database)/documents/bookingCancellations/$(token);
      return tokenValid(token) && exists(access) && !existsAfter(access) &&
        !existsAfter(booking) && !existsAfter(/databases/$(database)/documents/availability/$(slotKey));
    }
    function adminDeletedTogether(slotKey) {
      let booking = get(/databases/$(database)/documents/bookings/$(slotKey)).data;
      return isAdmin() && !existsAfter(/databases/$(database)/documents/bookings/$(slotKey)) &&
        !existsAfter(/databases/$(database)/documents/availability/$(slotKey)) &&
        (!('cancellationToken' in booking) || !existsAfter(/databases/$(database)/documents/bookingCancellations/$(booking.cancellationToken)));
    }
    function validCancellation(token) {
      let d = request.resource.data;
      let b = getAfter(/databases/$(database)/documents/bookings/$(d.slotKey)).data;
      return tokenValid(token) && d.keys().hasAll(['slotKey','bookingDate','bookingTime','firstName','lastName','email','occasion']) &&
        d.keys().hasOnly(['slotKey','bookingDate','bookingTime','firstName','lastName','email','occasion','timeZone']) &&
        b.cancellationToken == token && b.status in ['pending','confirmed'] &&
        d.slotKey == b.slotKey && d.bookingDate == b.bookingDate && d.bookingTime == b.bookingTime &&
        d.firstName == b.firstName && d.lastName == b.lastName && d.email == b.email &&
        d.occasion == b.get('occasion', '') && d.get('timeZone', '') == b.get('timeZone', '');
    }
    function validBookingUpdate(slotKey) {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['status','cancellationToken']) &&
        ((resource.data.status == 'pending' && d.status in ['pending','confirmed','denied']) || d.status == resource.data.status) &&
        (!('cancellationToken' in resource.data) || d.cancellationToken == resource.data.cancellationToken) &&
        (d.status == 'denied' ?
          (!existsAfter(/databases/$(database)/documents/availability/$(slotKey)) &&
            (!('cancellationToken' in d) || !existsAfter(/databases/$(database)/documents/bookingCancellations/$(d.cancellationToken)))) :
          (tokenValid(d.cancellationToken) &&
            getAfter(/databases/$(database)/documents/availability/$(slotKey)).data.date == d.bookingDate &&
            getAfter(/databases/$(database)/documents/bookingCancellations/$(d.cancellationToken)).data.slotKey == slotKey));
    }
    function validGalleryDesign(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() < 100 &&
        d.photos is list && d.photos.size() <= 500 &&
        d.get('coverStyle', 'fullbleed') in ['fullbleed','novel','frame','stripe','vintage','minimal'] &&
        d.get('coverHeight', 'medium') in ['short','medium','tall','fullscreen'] &&
        (d.get('coverPhotoId', null) == null || (d.coverPhotoId is string && d.coverPhotoId.size() <= 250)) &&
        d.get('overlayOpacity', 0.45) is number && d.get('overlayOpacity', 0.45) >= 0 && d.get('overlayOpacity', 0.45) <= 1 &&
        d.get('titleFont', 'Cormorant Garamond') in ['Cormorant Garamond','Playfair Display','DM Serif Display','Josefin Sans','Outfit','Raleway'] &&
        d.get('titleSize', 'lg') in ['sm','lg','xl','xxl'] &&
        d.get('titleWeight', '300') in ['200','300','400','500','600','700'] &&
        d.get('titleSpacing', 0.05) is number && d.get('titleSpacing', 0.05) >= -0.1 && d.get('titleSpacing', 0.05) <= 1 &&
        d.get('layout', 'masonry') in ['masonry','grid','rows','compact'] &&
        d.get('gridGap', 'sm') in ['none','xs','sm','md','lg','xl'] &&
        d.get('gridCols', 3) is int && d.get('gridCols', 3) >= 1 && d.get('gridCols', 3) <= 6;
    }
    match /bookings/{slotKey} {
      allow read: if isAdmin();
      allow create: if validNewBooking(slotKey);
      allow update: if (isAdmin() && validBookingUpdate(slotKey)) || (resource.data.status == 'denied' && validNewBooking(slotKey));
      allow delete: if adminDeletedTogether(slotKey) || cancelledTogether(slotKey);
    }
    match /availability/{slotKey} {
      allow get, list: if true;
      allow create: if request.resource.data.keys().hasOnly(['booked','date']) && request.resource.data.booked == true &&
        getAfter(/databases/$(database)/documents/bookings/$(slotKey)).data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/bookings/$(slotKey)).data.status == 'pending' &&
        getAfter(/databases/$(database)/documents/bookings/$(slotKey)).data.bookingDate == request.resource.data.date;
      allow delete: if cancelledTogether(slotKey) || (isAdmin() &&
        (!existsAfter(/databases/$(database)/documents/bookings/$(slotKey)) ||
          getAfter(/databases/$(database)/documents/bookings/$(slotKey)).data.status == 'denied'));
    }
    match /bookingCancellations/{token} {
      allow get: if tokenValid(token);
      allow list: if isAdmin();
      allow create: if validCancellation(token) && (isAdmin() ||
        (!exists(/databases/$(database)/documents/bookingReceipts/$(token)) &&
         getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.slotKey)).data.createdAt == request.time));
      allow update: if isAdmin() && validCancellation(token);
      allow delete: if (isAdmin() &&
        (!existsAfter(/databases/$(database)/documents/bookings/$(resource.data.slotKey)) ||
          getAfter(/databases/$(database)/documents/bookings/$(resource.data.slotKey)).data.status == 'denied')) ||
        (get(/databases/$(database)/documents/bookings/$(resource.data.slotKey)).data.cancellationToken == token && cancelledTogether(resource.data.slotKey));
    }


    match /galleries/{slug} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && validGalleryDesign(request.resource.data) && galleryPublished(slug);
      allow delete: if isAdmin() && !existsAfter(/databases/$(database)/documents/galleryShares/$(slug));
    }
    match /galleryShares/{slug} {
      allow get: if slug.matches('^[a-z0-9][a-z0-9-]{0,98}$');
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasAll(['version','salt','iv','ciphertext','revision']) &&
        request.resource.data.keys().hasOnly(['version','salt','iv','ciphertext','revision']) &&
        request.resource.data.version == 1 && bounded(request.resource.data.salt,24,24) &&
        bounded(request.resource.data.iv,16,16) && bounded(request.resource.data.ciphertext,24,800000) &&
        request.resource.data.revision is int &&
        getAfter(/databases/$(database)/documents/galleries/$(slug)).data.revision == request.resource.data.revision &&
        getAfter(/databases/$(database)/documents/galleries/$(slug)).data.access.salt == request.resource.data.salt;
      allow delete: if isAdmin() && !existsAfter(/databases/$(database)/documents/galleries/$(slug));
    }
    match /bookingReceipts/{token} {
      allow get: if tokenValid(token);
      allow list: if isAdmin();
      allow create: if tokenValid(token) && request.resource.data.keys().hasAll(['slotKey','digest','createdAt']) &&
        request.resource.data.keys().hasOnly(['slotKey','digest','createdAt']) &&
        tokenValid(request.resource.data.digest) && request.resource.data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.slotKey)).data.createdAt == request.time &&
        getAfter(/databases/$(database)/documents/bookings/$(request.resource.data.slotKey)).data.cancellationToken == token;
    }
    match /bookingHistory/{id} { allow read, create: if isAdmin(); }
  }
}
